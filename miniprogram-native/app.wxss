page {
  background: #ededed;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1f1f1f;
}
.page { padding: 24rpx; }
.quick-card { background:#fff; border-radius:20rpx; padding:24rpx; box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04); }
.quick-input { width:100%; min-height:120rpx; font-size:30rpx; line-height:1.5; }
.capsules { display:flex; flex-wrap:wrap; margin:16rpx 0; }
.cap { font-size:24rpx; padding:8rpx 20rpx; background:#f2f3f5; color:#555; border-radius:999rpx; margin:0 12rpx 12rpx 0; }
.cap-on { background:#07c160; color:#fff; }
.row { display:flex; align-items:center; justify-content:space-between; margin-top:8rpx; }
.hint { font-size:24rpx; color:#999; }
.save-btn { background:#07c160; color:#fff; font-size:26rpx; padding:0 32rpx; height:64rpx; line-height:64rpx; border-radius:999rpx; }
.save-btn::after { border:none; }
.list { margin-top:24rpx; }
.card { background:#fff; border-radius:20rpx; padding:24rpx; margin-bottom:20rpx; box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04); }
.card-top { display:flex; justify-content:space-between; align-items:center; }
.card-title { font-size:30rpx; font-weight:600; }
.tag { font-size:22rpx; color:#07c160; background:#e8f8ee; padding:4rpx 14rpx; border-radius:999rpx; }
.card-content { display:block; font-size:26rpx; color:#555; margin:12rpx 0; line-height:1.5; }
.card-foot { display:flex; flex-direction:column; }
.date { font-size:22rpx; color:#aaa; }
.summary { font-size:24rpx; color:#888; margin-top:4rpx; }
.empty { text-align:center; color:#aaa; font-size:26rpx; padding:60rpx 0; }
.mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.4); display:flex; align-items:flex-end; z-index:10; }
.sheet { background:#fff; width:100%; padding:32rpx; border-radius:24rpx 24rpx 0 0; box-sizing:border-box; }
.edit-input { width:100%; min-height:200rpx; font-size:30rpx; border:1rpx solid #eee; border-radius:12rpx; padding:16rpx; box-sizing:border-box; }
.del { background:#fdeaea; color:#e54d42; font-size:26rpx; height:64rpx; line-height:64rpx; border-radius:999rpx; }
.del::after { border:none; }
.sec-title { font-size:30rpx; font-weight:600; margin-bottom:16rpx; }
.field { display:flex; flex-direction:column; margin-bottom:20rpx; }
.label { font-size:24rpx; color:#666; margin-bottom:8rpx; }
.input { width:100%; height:72rpx; border:1rpx solid #eee; border-radius:12rpx; padding:0 20rpx; font-size:28rpx; box-sizing:border-box; }
.picker-value { height:72rpx; line-height:72rpx; border:1rpx solid #eee; border-radius:12rpx; padding:0 20rpx; font-size:28rpx; background:#fafafa; }
.plain-btn { background:#f2f3f5; color:#333; font-size:26rpx; height:64rpx; line-height:64rpx; border-radius:999rpx; }
.plain-btn::after { border:none; }
.err { color:#e54d42; font-size:24rpx; margin-top:8rpx; }
.dec { display:block; margin-top:16rpx; font-size:26rpx; color:#333; background:#f7f7f7; border-radius:12rpx; padding:16rpx; white-space:pre-wrap; }
.about { font-size:26rpx; color:#666; line-height:1.6; white-space:pre-line; }
.day-group { margin-bottom:24rpx; }
.day-head { display:flex; justify-content:space-between; padding:8rpx 8rpx 12rpx; }
.day-date { font-size:28rpx; font-weight:600; color:#333; }
.day-count { font-size:24rpx; color:#999; }
